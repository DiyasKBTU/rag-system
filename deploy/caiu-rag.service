[Unit]
Description=CAIU RAG Service (FastAPI)
Documentation=https://github.com/your-org/caiu-bot
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER

WorkingDirectory=/home/YOUR_USER/caiu-bot/rag_service
EnvironmentFile=/home/YOUR_USER/caiu-bot/rag_service/.env

ExecStart=/home/YOUR_USER/caiu-bot/venv/bin/python run_api.py

# Перезапускать при любом падении, но не чаще раза в 10 секунд
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=5

# Логи идут через journald — смотреть: journalctl -u caiu-rag -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=caiu-rag

# Таймауты
TimeoutStartSec=30
TimeoutStopSec=15

# Безопасность: запрет записи за пределами проекта
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
