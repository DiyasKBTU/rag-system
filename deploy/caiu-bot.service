[Unit]
Description=CAIU Telegram Bot (aiogram)
Documentation=https://github.com/your-org/caiu-bot
After=network.target caiu-rag.service
# Бот зависит от RAG-сервиса — стартует после него
Wants=caiu-rag.service

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER

WorkingDirectory=/home/YOUR_USER/caiu-bot
EnvironmentFile=/home/YOUR_USER/caiu-bot/.env

ExecStart=/home/YOUR_USER/caiu-bot/venv/bin/python bot/run.py

# Перезапускать при любом падении, но не чаще раза в 10 секунд
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=5

# Логи идут через journald — смотреть: journalctl -u caiu-bot -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=caiu-bot

# Таймауты
TimeoutStartSec=30
TimeoutStopSec=15

# Безопасность
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
